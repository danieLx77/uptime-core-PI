            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          }
        },
        "required": [
          "stateChanged",
          "incidentId"
        ],
        "description": "Quando o estado mudou, incidentId é obrigatório e não nulo. Sem transição, pode identificar um incidente já aberto ou ser nulo.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "stateChanged": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "incidentId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "properties": {
