            "type": "string",
            "format": "date-time"
          },
          "monitorId": {
            "type": "string",
            "example": "8b76da0a-927f-4a91-ba67-6cf05a05c23f",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "success": {
            "type": "boolean"
          },
