generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MonitorStatus {
  ACTIVE
  PAUSED
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password_hash        String
  role                 Role      @default(USER)
  passwordResetDigest  String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  monitors             Monitor[]

  @@map("users")
}

model Monitor {
  id               String        @id @default(uuid())
  userId           String
  name             String
  url              String
  interval_minutes Int           @default(5)
  status           MonitorStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions       CheckExecution[]



  @@map("monitors")
}

model CheckExecution {
  id               String   @id @default(uuid())
  monitorId        String
  status_code      Int?     // Opcional (Pode ser nulo em caso de timeout onde nem chega a ter HTTP Status)
  response_time_ms Int
  timestamp        DateTime @default(now())

  monitor          Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // O ÍNDICE ESTRATÉGICO que definimos no Notion para salvar a performance!
  @@index([monitorId, timestamp])
  @@map("check_executions")
}
