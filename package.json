{
  "name": "uptime-core-api",
  "version": "1.0.0",
  "description": "API de monitoramento de disponibilidade e tempo de resposta",
  "type": "module",
  "scripts": {
    "start": "npm run start -w @uptime/gateway",
    "lint": "eslint services/*/src gateway/src",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "npm run db:migrate --workspaces --if-present",
    "prepare": "husky",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --watch --runInBand --forceExit",
    "test:db-setup": "dotenv -e .env.test -- npm run db:migrate",
    "test:architecture": "node scripts/architecture/check.mjs && node --test --test-isolation=none scripts/architecture/self-check.mjs",
    "db:validate": "npm run db:validate --workspaces --if-present",
    "db:generate": "npm run db:generate --workspaces --if-present",
    "test:contracts": "node scripts/validate-openapi.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "acorn": "^8.16.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "private": true,
  "workspaces": [
    "services/core",
    "services/incidents",
    "gateway"
  ]
}
